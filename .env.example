# Browser DSN. Inlined at build time. Leave unset to disable client reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Server and edge DSN. Read at runtime. Falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=

# Source map upload and release creation. Leave unset to skip upload; the build still succeeds.
# Org and project default to eurodelices / sentry-autofix-demo when these are blank.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Event environment. Vercel sets VERCEL_ENV (production, preview, development).
# SENTRY_ENVIRONMENT overrides it when you need a different name.
SENTRY_ENVIRONMENT=
VERCEL_ENV=

# Release name injected by the Sentry build plugin. Vercel sets this on every deployment.
VERCEL_GIT_COMMIT_SHA=

# Set to true to print Sentry SDK debug logs, including envelope delivery.
SENTRY_DEBUG=
