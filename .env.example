# Browser DSN. Inlined at build time. Leave unset to disable client reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Server and edge DSN. Read at runtime. Falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=

# Source map upload. If any of these are unset, upload is skipped and the build still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry release. Vercel sets this on every deployment. Optional for local runs.
VERCEL_GIT_COMMIT_SHA=
